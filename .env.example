# Copy to .env. Never commit .env or a real tunnel token.
TUNNEL_TOKEN=remplacer_par_le_token_du_tunnel
# One hostname, without https://, path, port or wildcard.
HELM_PUBLIC_HOST=helm.example.com
# Dedicated clone with a real .git directory, owned by UID/GID 1000.
# Relative paths are resolved from the directory containing docker-compose.yml.
TARGET_REPO=./deploy/repo
